# ============================================================================
# aegis-mem Environment Configuration Template
# ============================================================================

# --- Vector Database (Qdrant) ---
AEGIS_QDRANT_HOST=localhost
AEGIS_QDRANT_PORT=6333
AEGIS_QDRANT_IN_MEMORY=false
AEGIS_COLLECTION_NAME=aegis_procedural_rules

# --- Primary LLM & Embeddings (OpenAI-Compatible) ---
AEGIS_LLM_PROVIDER=openai
AEGIS_LLM_MODEL=gpt-4o-mini
AEGIS_LLM_API_KEY=sk-your-api-key-here
AEGIS_LLM_BASE_URL=https://api.openai.com/v1

# --- Embedding Configuration ---
AEGIS_EMBEDDER_PROVIDER=openai
AEGIS_EMBEDDER_MODEL=text-embedding-3-small

# --- Telemetry & Audit ---
AEGIS_TELEMETRY_DB_PATH=./data/aegis_telemetry.sqlite

# --- Cloud API Server ---
AEGIS_API_HOST=0.0.0.0
AEGIS_API_PORT=8080

